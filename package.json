{
  "name": "copis",
  "version": "0.1.2",
  "description": "Copis Working desktop client",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@copis/electron' dev",
    "electron:dev": "bun run --filter='@copis/electron' dev",
    "electron:build": "bun run --filter='@copis/electron' build",
    "electron:start": "bun run --filter='@copis/electron' start",
    "build:node-runtime-module": "bun run scripts/build-node-runtime-module.ts",
    "build:playwright-core-module": "bun run scripts/build-playwright-core-module.ts",
    "prepare:alipay-bot-module": "bun run scripts/prepare-alipay-bot-module.ts",
    "prepare:officecli-module": "bun run scripts/prepare-officecli-module.ts",
    "build:functional-module-manifest": "bun run scripts/build-functional-module-manifest.ts",
    "publish:functional-modules": "bun run scripts/publish-functional-modules.ts",
    "publish:app-updates": "bun run scripts/publish-app-updates.ts",
    "publish:windows-installer": "bun run scripts/publish-windows-installer.ts",
    "publish:macos-installer": "bun run scripts/publish-macos-installer.ts",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test --isolate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "dompurify": "^3.4.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.84.1": "patches/@earendil-works%2Fpi-ai@0.84.1.patch",
    "@earendil-works/pi-coding-agent@0.84.1": "patches/@earendil-works%2Fpi-coding-agent@0.84.1.patch"
  }
}
